generator client {
    provider = "prisma-client-js"
    binaryTargets = ["native", "linux-musl-arm64-openssl-3.0.x"]
    previewFeatures = []
}

datasource db {
    provider = "postgresql"
    url      = env("DATABASE_URL")
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model User {
  id           String    @id @default(cuid())
  email        String    @unique
  name         String?
  password     String?
  role         Role      @default(USER)
  profileImage String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  // Relations
  accounts         Account[]
  sessions         Session[]
  dog              Dog?
  routesCreated    Route[]         @relation("RouteCreator")
  participations   Participation[]
  userAchievements UserAchievement[]
  reviews          Review[]

  @@map("users")
}

model Dog {
  id                   String  @id @default(cuid())
  userId               String  @unique
  name                 String
  age                  Int?
  breed                String?
  characterWithPeople  String?
  characterWithDogs    String?
  isCastrated          Boolean @default(false)
  profileImage         String?
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("dogs")
}

model Route {
  id          String   @id @default(cuid())
  title       String
  description String?
  kilometers  Float
  date        DateTime
  createdBy   String
  maxParticipants Int?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  creator        User            @relation("RouteCreator", fields: [createdBy], references: [id])
  participations Participation[]
  reviews        Review[]

  @@map("routes")
}

model Participation {
  id           String    @id @default(cuid())
  userId       String
  routeId      String
  registeredAt DateTime  @default(now())
  attended     Boolean   @default(false)
  attendedAt   DateTime?

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  route Route @relation(fields: [routeId], references: [id], onDelete: Cascade)

  @@unique([userId, routeId])
  @@map("participations")
}

model Achievement {
  id          String @id @default(cuid())
  name        String @unique
  description String
  type        AchievementType
  condition   String // JSON string with condition details
  medalIcon   String
  createdAt   DateTime @default(now())

  userAchievements UserAchievement[]

  @@map("achievements")
}

model UserAchievement {
  id            String   @id @default(cuid())
  userId        String
  achievementId String
  unlockedAt    DateTime @default(now())
  notified      Boolean  @default(false)

  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  achievement Achievement @relation(fields: [achievementId], references: [id], onDelete: Cascade)

  @@unique([userId, achievementId])
  @@map("user_achievements")
}

model Review {
  id        String   @id @default(cuid())
  userId    String
  routeId   String
  rating    Int      @db.SmallInt // 1-5 stars
  comment   String?
  createdAt DateTime @default(now())

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  route Route @relation(fields: [routeId], references: [id], onDelete: Cascade)

  @@unique([userId, routeId])
  @@map("reviews")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

enum Role {
  USER
  ADMIN
}

enum AchievementType {
  EVENTS_TOTAL
  KILOMETERS_TOTAL
  EVENTS_CONSECUTIVE
  MONTHLY_COMPLETE
}
