{
  "version": 2,
  "builds": [
    {
      "src": "app/package.json",
      "use": "@vercel/next"
    }
  ],
  "routes": [
    {
      "src": "/(.*)",
      "dest": "/app/$1"
    }
  ],
  "env": {
    "DATABASE_URL": "@database_url"
  },
  "buildCommand": "cd app && npm run build",
  "installCommand": "cd app && npm ci"
}
